# Loaded automatically via next.config.ts (merged into process.env if unset).
# Prefer `.env.local` for secrets so this file can stay a safe template in git.
#
# Stripe → Developers → API keys: full secret only (sk_test_… or sk_live_…).
#
# Public site URL (no trailing slash) — canonical URLs, Open Graph, sitemap, JSON-LD.
# NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
#
# Origin used to build Stripe checkout success/cancel URLs when the request
# carries no Origin header. Set to the deployed site URL on Netlify.
# NEXT_PUBLIC_APP_URL=https://www.yourdomain.com
#

# ── Shopify headless (optional — checkout falls back to Stripe when unset) ──
# Store domain, e.g. your-store.myshopify.com (no protocol)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
# Storefront API access token (public token from a custom app, NOT the Admin token)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
